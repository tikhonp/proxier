package pages

import (
	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/ui"
	"strconv"
)

templ rlistPage(s ui.Shell, v listPageView) {
	@ui.Layout(s) {
		<div class="titleblock">
			<div class="head">
				@listCrumbs(v.L.ID, v.L.Name, "")
				<h1>{ v.L.Name }</h1>
				<p class="subtle">{ v.Line }</p>
				if v.L.Description != "" {
					<p class="sm subtle">{ v.L.Description }</p>
				}
			</div>
			<div class="actions">
				@ui.ActionButton(ui.Action{ID: "lists.add", Label: "lists.add", Method: "GET", Href: listHref(v.L.ID) + "/add", Key: "n", Kind: ui.Primary})
			</div>
		</div>
		if v.Band != "" {
			@ui.Alert("pine", "status") {
				{ v.Band }
			}
		}
		<div class="subcols">
			<div class="col-l">
				@membersArea(v.Members)
			</div>
			<div class="col-r">
				@ui.Area(i18n.T(ctx, "lists.area.targets", i18n.Args{"n": len(v.Targets)}), "") {
					if len(v.Targets) == 0 {
						<p class="subtle area-body">{ i18n.T(ctx, "lists.targets.none", i18n.Args{"name": v.L.Name}) }</p>
					}
					for _, t := range v.Targets {
						<div class="row">
							@ui.Status(t.Kind, t.Name)
							<span class="sm subtle">{ t.Word }</span>
						</div>
					}
				}
				@ui.Area(i18n.T(ctx, "lists.area.warnings", i18n.Args{"n": len(v.Warnings)}), "") {
					if len(v.Warnings) == 0 {
						<p class="subtle area-body">{ i18n.T(ctx, "lists.warnings.none") }</p>
					}
					for _, w := range v.Warnings {
						<div class="row warn">
							<span class="gold" aria-hidden="true">▲</span>
							<span class="col">
								<a href={ templ.SafeURL(w.Href) }>{ w.Text }</a>
								if w.Time != "" {
									<span class="sm subtle">{ w.Time }</span>
								}
							</span>
						</div>
					}
				}
				@ui.Area(i18n.T(ctx, "lists.area.actions"), "") {
					<div class="row act">
						@ui.ActionButton(ui.Action{ID: "lists.rename", Label: "lists.rename", Method: "GET", Href: listHref(v.L.ID) + "/edit", Small: true})
						<span class="sm subtle">{ i18n.T(ctx, "lists.rename.note") }</span>
					</div>
					if !v.L.Default {
						<div class="row act">
							@ui.ActionButton(ui.Action{ID: "lists.make_default", Label: "lists.make_default", Method: "POST", Href: listHref(v.L.ID) + "/default", Small: true})
							<span class="sm subtle">{ i18n.T(ctx, "lists.make_default.note") }</span>
						</div>
					}
					<div class="row act">
						@ui.ActionButton(ui.Action{ID: "lists.delete", Label: "lists.delete", Method: "GET", Href: listHref(v.L.ID) + "/delete", Small: true, Kind: ui.Danger})
						if v.L.Default {
							<span class="sm subtle">{ i18n.T(ctx, "lists.delete.default") }</span>
						} else {
							<span class="sm subtle">{ i18n.T(ctx, "lists.delete.note") }</span>
						}
					</div>
				}
				@ui.Area(i18n.T(ctx, "lists.area.activity"), "") {
					if len(v.Activity) == 0 {
						<p class="subtle area-body">{ i18n.T(ctx, "services.activity.none") }</p>
					}
					for _, e := range v.Activity {
						<div class="row evt"><span class="subtle">{ e.Time }</span><span>{ e.Text }</span></div>
					}
					<p class="area-body"><a href={ templ.SafeURL("/activity?subject=routing_list:" + i64(v.L.ID)) }>{ i18n.T(ctx, "services.activity.all") }</a></p>
				}
			</div>
		</div>
	}
}

// membersArea is the Services area; htmx answers replace it whole.
templ membersArea(v membersView) {
	<section class="area" id="members-area" aria-label={ i18n.T(ctx, "lists.area.services") }>
		<div class="pc-title">
			<h2>{ i18n.T(ctx, "lists.area.services") }</h2>
			<span class="note">{ i18n.T(ctx, "lists.area.services.note") }</span>
			<span class="flex1"></span>
		</div>
		if v.Stale {
			@ui.Alert("gold", "alert") {
				{ i18n.T(ctx, "lists.order.stale") }
			}
		}
		if v.Undo != nil {
			<div class="band pine undo" role="status">
				<span class="col">
					<span>{ v.Undo.Moved }</span>
					<span class="sm">{ v.Undo.Owners }</span>
					if v.Undo.Targets != "" {
						<span class="sm">{ v.Undo.Targets }</span>
					}
				</span>
				<form method="post" action={ templ.SafeURL(listHref(v.ListID) + "/services/order") } hx-post={ listHref(v.ListID) + "/services/order" } hx-target="#members-area" hx-swap="outerHTML" class="inline">
					<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
					<input type="hidden" name="order" value={ v.Undo.Order }/>
					<input type="hidden" name="expect" value={ v.Undo.Expect }/>
					<button type="submit" class="pc-btn pc-sm" data-key="u" data-action="lists.undo">{ i18n.T(ctx, "lists.undo") } <span class="k">u</span></button>
				</form>
			</div>
		}
		if len(v.Rows) == 0 {
			<p class="subtle area-body">{ i18n.T(ctx, "lists.services.empty", i18n.Args{"name": v.Name}) }</p>
			<p class="area-body">
				@ui.ActionButton(ui.Action{ID: "lists.add.empty", Label: "lists.add", Method: "GET", Href: listHref(v.ListID) + "/add", Small: true})
			</p>
		} else {
			<div data-sortable>
				for _, r := range v.Rows {
					<div class="row member pc-row" data-row={ i64(r.ID) } data-sort-id={ i64(r.ID) } data-hint={ i18n.T(ctx, "lists.hints.member", i18n.Args{"tag": r.Tag}) } data-href={ svcHref(r.ID) } data-cursor?={ r.Cursor }>
						<span class="caret" aria-hidden="true">›</span>
						<span class="handle" data-sort-handle aria-hidden="true" title={ i18n.T(ctx, "lists.drag") }>⋮⋮</span>
						<span class="subtle">{ strconv.Itoa(r.Pos) }</span>
						<span class="col">
							<a href={ templ.SafeURL(svcHref(r.ID)) } class="bold">{ r.Tag }</a>
							if r.Sub != "" {
								<span class="sm subtle seltext">{ r.Sub }</span>
							}
						</span>
						<span class="hl" title={ i18n.T(ctx, "lists.owned_total") }>
							{ r.Owned }
							if r.Same {
								<span class="muted">/ { r.Total }</span>
							} else {
								<span class="subtle">/ { r.Total }</span>
							}
						</span>
						<span class="out sm subtle">{ r.Source } · { i18n.T(ctx, "services.state.ok") }</span>
						<span class="acts">
							@listMoveButton(v.ListID, r, "up")
							@listMoveButton(v.ListID, r, "down")
							@ui.ActionButton(ui.Action{
								ID: "lists.remove." + i64(r.ID), Label: "lists.remove", Method: "POST", Small: true, Kind: ui.Ghost,
								Href: listHref(v.ListID) + "/services/" + i64(r.ID) + "/remove",
								Confirm: &ui.Confirm{Strength: 1, Title: i18n.T(ctx, "lists.remove.title", i18n.Args{"tag": r.Tag, "name": v.Name}), Body: i18n.T(ctx, "lists.remove.body", i18n.Args{"tag": r.Tag, "name": v.Name})},
							})
						</span>
					</div>
				}
			</div>
			<form method="post" action={ templ.SafeURL(listHref(v.ListID) + "/services/order") } data-sortable-form hx-post={ listHref(v.ListID) + "/services/order" } hx-target="#members-area" hx-swap="outerHTML" class="hidden">
				<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
				<input type="hidden" name="order" value={ v.OrderCSV }/>
			</form>
			<p class="sm subtle area-body">{ i18n.T(ctx, "lists.services.note") }</p>
		}
	</section>
}

// listMoveButton is ↑ (K) or ↓ (J) of a row: keys act on the row under the cursor only.
templ listMoveButton(list int64, r memberRow, dir string) {
	<form method="post" action={ templ.SafeURL(listHref(list) + "/services/" + i64(r.ID) + "/move") } hx-post={ listHref(list) + "/services/" + i64(r.ID) + "/move" } hx-target="#members-area" hx-swap="outerHTML" class="inline">
		<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
		<input type="hidden" name="dir" value={ dir }/>
		if dir == "up" {
			<button type="submit" class="pc-btn pc-sm" data-key="K" data-row-only disabled?={ r.First } aria-label={ i18n.T(ctx, "lists.move.up", i18n.Args{"tag": r.Tag}) }>↑</button>
		} else {
			<button type="submit" class="pc-btn pc-sm" data-key="J" data-row-only disabled?={ r.Last } aria-label={ i18n.T(ctx, "lists.move.down", i18n.Args{"tag": r.Tag}) }>↓</button>
		}
	</form>
}
