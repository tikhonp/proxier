package pages

import (
	"strconv"

	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/ui"
)

func sevClass(sev string) string {
	if sev == "error" {
		return "st-broken"
	}
	return "st-look"
}

// paramsPanel is RP-Script's aside. The draft's (Live) is #params-panel: the
// text area swaps it as the text changes, and the editor bundle turns its
// problem rows into lint markers.
templ paramsPanel(v panelView) {
	<aside
		class="rs-panel"
		if v.Live {
			id="params-panel"
			data-code-findings="draft-body"
		} else {
			id="version-params"
		}
		aria-label={ i18n.T(ctx, "scripts.panel.title") }
	>
		<div class="pc-title">
			<h2>{ i18n.T(ctx, "scripts.panel.count", i18n.Args{"n": v.Params}) }</h2>
			if v.Live {
				<span class="note">{ i18n.T(ctx, "scripts.panel.live") }</span>
			}
			<span class="flex1"></span>
		</div>
		if !v.Block {
			<p class="subtle area-body">{ i18n.T(ctx, "scripts.panel.no_block") }</p>
		}
		for _, g := range v.Groups {
			<div class="rs-group">
				if g.Heading != "" {
					<p class="rs-heading">{ g.Heading }</p>
				}
				for _, it := range g.Items {
					<div class={ "rs-item", templ.KV("computed", it.Computed) }>
						<div class="rs-line">
							<span class="bold">{ it.Name }</span>
							if it.Computed {
								<span class="subtle">= { it.Expr }</span>
								if it.Value != "" {
									<span class="gold">→ { it.Value }</span>
								}
							} else {
								<span class="gold">{ it.Default }</span>
								if it.Ann != "" {
									<span class="iris">{ it.Ann }</span>
								}
							}
						</div>
						if it.Desc != "" {
							<p class="sm subtle">{ it.Desc }</p>
						}
					</div>
				}
			</div>
		}
		if v.Computed > 0 {
			<p class="sm muted area-body">{ i18n.N(ctx, "scripts.panel.computed", int64(v.Computed)) }</p>
		}
		if len(v.Problems) > 0 {
			<ul class="rs-problems">
				for _, p := range v.Problems {
					<li data-code-finding data-line={ strconv.Itoa(p.Line) } data-sev={ p.Sev } data-msg={ p.Text }>
						<span class={ "st", sevClass(p.Sev) } aria-hidden="true"></span>
						if p.Line > 0 {
							<span class="bold">{ i18n.T(ctx, "scripts.panel.line", i18n.Args{"line": strconv.Itoa(p.Line)}) }</span>
						}
						<span class={ templ.KV("love", p.Sev == "error"), templ.KV("gold", p.Sev != "error") }>{ p.Text }</span>
					</li>
				}
			</ul>
		}
	</aside>
}

templ scriptPage(s ui.Shell, v scriptView) {
	@ui.Layout(s) {
		<div class="titleblock">
			<div class="head">
				@crumbs(v.S.ID, v.S.Name, "")
				<div class="jobtitle">
					<h1>{ v.S.Name }</h1>
					if v.S.Archived {
						@ui.Status("off", i18n.T(ctx, "scripts.archived"))
					}
				</div>
				<p class="subtle">{ v.Line }</p>
			</div>
			<div class="actions">
				if v.Draft {
					<button type="submit" form="draft-form" class="pc-btn" data-action="rs.save" data-code-save disabled?={ v.Stale }>{ i18n.T(ctx, "scripts.save") }</button>
					<button type="submit" form="draft-form" name="next" value="publish" class="pc-btn pc-pri" data-action="rs.publish" disabled?={ v.Stale }>{ i18n.T(ctx, "scripts.publish", i18n.Args{"version": strconv.Itoa(v.Next)}) }</button>
				} else if v.S.Current > 0 {
					@ui.ActionButton(ui.Action{ID: "rs.edit", Label: "scripts.edit", Method: "POST", Href: ScriptHref(v.S.ID) + "/edit", Key: "e"})
				}
				if v.CanGenerate {
					@ui.ActionButton(ui.Action{ID: "rs.generate", Label: "generations.form.title", Method: "GET", Href: GenerateHref(v.S.ID), Key: "n", Kind: genKind(v.Draft)})
				} else {
					<button type="button" class="pc-btn" disabled title={ i18n.T(ctx, "generations.form.off") }>{ i18n.T(ctx, "generations.form.title") }</button>
				}
			</div>
		</div>
		if v.Stale {
			@ui.Band("gold") {
				<span class="gold bold">{ i18n.T(ctx, "scripts.stale.title") }</span>
				<span class="subtle">{ i18n.T(ctx, "scripts.stale.body") }</span>
				<span class="flex1"></span>
				<a href={ templ.SafeURL(ScriptHref(v.S.ID) + "#draft") } class="pc-btn pc-sm" data-action="rs.reload">{ i18n.T(ctx, "scripts.stale.reload") }</a>
			}
		} else if v.Band != "" {
			@ui.Band(v.BandKind) {
				{ v.Band }
			}
		}
		<section class="area" id="draft" aria-label={ i18n.T(ctx, "scripts.area.draft") }>
			<div class="pc-title">
				<h2>{ i18n.T(ctx, "scripts.area.draft") }</h2>
				<span class="note">{ i18n.T(ctx, "scripts.area.draft.note") }</span>
				<span class="flex1"></span>
				if v.Draft && (v.BasedOn > 0 || v.S.Current > 0) {
					<a href={ templ.SafeURL(ScriptHref(v.S.ID) + "/diff") } class="sm">{ i18n.T(ctx, "scripts.draft.view_diff") }</a>
				}
			</div>
			if v.Draft {
				<div class="rs-editor">
					<form id="draft-form" method="post" action={ templ.SafeURL(ScriptHref(v.S.ID) + "/draft") } enctype="multipart/form-data" class="rs-draft">
						<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
						<input type="hidden" name="revision" value={ strconv.Itoa(v.Revision) }/>
						<textarea id="draft-body" class="pc-inp pc-ta rs-body" name="body" aria-label={ i18n.T(ctx, "scripts.field.body") } rows="30" spellcheck="false" data-code="routeros" hx-post={ ScriptHref(v.S.ID) + "/draft/parameters" } hx-trigger="input changed delay:400ms" hx-target="#params-panel" hx-swap="outerHTML" aria-invalid?={ v.BodyErr != "" }>{ "\n" + v.Body }</textarea>
						@fieldErr(v.BodyErr)
						<div class="inline-fields">
							<label for="draft-file" class="sm subtle">{ i18n.T(ctx, "scripts.field.replace_file") }</label>
							<input id="draft-file" type="file" name="file" accept=".rsc,.txt,text/plain"/>
						</div>
					</form>
					@paramsPanel(v.Panel)
				</div>
			} else if v.S.Current > 0 {
				<p class="subtle area-body">{ i18n.T(ctx, "scripts.draft.no_draft", i18n.Args{"version": strconv.Itoa(v.S.Current)}) }</p>
			}
		</section>
		<div class="subcols">
			<div class="col-l">
				@ui.Area(i18n.T(ctx, "scripts.area.versions"), "") {
					if len(v.Versions) == 0 {
						<p class="subtle area-body">{ i18n.T(ctx, "scripts.versions.none") }</p>
					}
					for _, ver := range v.Versions {
						<div class="row rsver">
							<span class="bold">
								v{ strconv.Itoa(ver.Number) }
								if ver.Current {
									<span class="pine normal">· { i18n.T(ctx, "scripts.version.current") }</span>
								}
							</span>
							<span class="col">
								<span class="sm subtle">{ ver.Published } · { ver.Gens }</span>
								if ver.Notes != "" {
									<span class="sm notes">{ ver.Notes }</span>
								}
							</span>
							<span class="actions">
								<a class="pc-btn pc-sm" href={ templ.SafeURL(ScriptHref(v.S.ID) + "/versions/" + strconv.Itoa(ver.Number)) } data-action={ "rs.view." + strconv.Itoa(ver.Number) }>{ i18n.T(ctx, "scripts.version.view") }</a>
								if ver.HasPrev {
									<a class="pc-btn pc-sm" href={ templ.SafeURL(ScriptHref(v.S.ID) + "/diff?from=" + strconv.Itoa(ver.Number-1) + "&to=" + strconv.Itoa(ver.Number)) }>{ i18n.T(ctx, "scripts.version.diff") }</a>
								}
								<a class="pc-btn pc-sm" href={ templ.SafeURL(ScriptHref(v.S.ID) + "/versions/" + strconv.Itoa(ver.Number) + "/download") } download>{ i18n.T(ctx, "scripts.version.download") }</a>
								if !ver.Current {
									@ui.ActionButton(ui.Action{
										ID: "rs.current." + strconv.Itoa(ver.Number), Label: "scripts.version.make_current", Method: "POST", Small: true,
										Href:    ScriptHref(v.S.ID) + "/versions/" + strconv.Itoa(ver.Number) + "/current",
										Confirm: &ui.Confirm{Strength: 1, Title: i18n.T(ctx, "scripts.current.title", i18n.Args{"version": strconv.Itoa(ver.Number)}), Body: i18n.T(ctx, "scripts.current.body", i18n.Args{"version": strconv.Itoa(ver.Number), "current": strconv.Itoa(v.S.Current)})},
									})
								}
							</span>
						</div>
					}
				}
			</div>
			<div class="col-r">
				@ui.Area(i18n.T(ctx, "scripts.area.generations"), "") {
					if len(v.GenRows) == 0 {
						<p class="subtle area-body">{ i18n.T(ctx, "scripts.generations.none") }</p>
					}
					for _, g := range v.GenRows {
						<a class="row rsgen" href={ templ.SafeURL(GenerationHref(g.ID)) } data-row>
							<span class="bold">{ g.RouterName }</span>
							<span class="subtle">{ g.Version } · { g.Created }</span>
							@ui.Status(g.StateSt, g.State)
						</a>
					}
				}
			</div>
		</div>
		@ui.Area(i18n.T(ctx, "scripts.area.actions"), "") {
			@actionRow(ui.Action{ID: "rs.details", Label: "scripts.details", Method: "GET", Href: ScriptHref(v.S.ID) + "/details", Small: true}, i18n.T(ctx, "scripts.details.what"))
			if v.Draft && v.S.Current > 0 {
				@actionRow(ui.Action{
					ID: "rs.discard", Label: "scripts.discard", Method: "POST", Href: ScriptHref(v.S.ID) + "/draft/discard", Small: true,
					Confirm: &ui.Confirm{Strength: 1, Title: i18n.T(ctx, "scripts.discard.title"), Body: i18n.T(ctx, "scripts.discard.body", i18n.Args{"version": strconv.Itoa(v.S.Current)})},
				}, i18n.T(ctx, "scripts.discard.what"))
			}
			if v.S.Archived {
				@actionRow(ui.Action{ID: "rs.unarchive", Label: "scripts.unarchive", Method: "POST", Href: ScriptHref(v.S.ID) + "/unarchive", Small: true}, i18n.T(ctx, "scripts.unarchive.what"))
			} else {
				@actionRow(ui.Action{ID: "rs.archive", Label: "scripts.archive", Method: "POST", Href: ScriptHref(v.S.ID) + "/archive", Small: true}, i18n.T(ctx, "scripts.archive.what"))
			}
			@actionRow(ui.Action{ID: "rs.delete", Label: "scripts.delete", Method: "GET", Href: ScriptHref(v.S.ID) + "/delete", Small: true, Kind: ui.Danger}, i18n.T(ctx, "scripts.delete.what"))
		}
		@ui.Area(i18n.T(ctx, "scripts.area.activity"), "") {
			if len(v.Activity) == 0 {
				<p class="subtle area-body">{ i18n.T(ctx, "scripts.activity.none") }</p>
			}
			for _, e := range v.Activity {
				<div class="row evt"><span class="subtle">{ e.Time }</span><span>{ e.Text }</span></div>
			}
			<p class="area-body"><a href={ templ.SafeURL("/activity?subject=router_script:" + i64(v.S.ID)) }>{ i18n.T(ctx, "scripts.activity.all") }</a></p>
		}
	}
}

templ actionRow(a ui.Action, what string) {
	<div class="row act">
		@ui.ActionButton(a)
		<span class="sm subtle">{ what }</span>
	</div>
}

// publishPage is a page styled as a dialog: the report, notes, the tick for
// warnings and what happens.
templ publishPage(s ui.Shell, v publishView, title string) {
	@ui.Layout(s) {
		<div class="titleblock">
			<div class="head">
				@crumbs(v.S.ID, v.S.Name, i18n.T(ctx, "scripts.publish.crumb"))
				<h1>{ title }</h1>
			</div>
		</div>
		if v.Stale {
			@ui.Band("gold") {
				<span class="gold bold">{ i18n.T(ctx, "scripts.stale.title") }</span>
				<span class="subtle">{ i18n.T(ctx, "scripts.stale.body") }</span>
				<span class="flex1"></span>
				<a href={ templ.SafeURL(ScriptHref(v.S.ID) + "#draft") } class="pc-btn pc-sm">{ i18n.T(ctx, "scripts.stale.reload") }</a>
			}
		} else {
			<form method="post" action={ templ.SafeURL(ScriptHref(v.S.ID) + "/publish") } class="pub">
				<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
				<input type="hidden" name="revision" value={ strconv.Itoa(v.Revision) }/>
				if len(v.Errors) > 0 {
					@ui.Alert("love", "alert") {
						<span class="bold">{ i18n.N(ctx, "scripts.publish.errors", int64(len(v.Errors))) }</span>
						<span>{ i18n.T(ctx, "scripts.publish.blocked") }</span>
					}
				} else if len(v.Warnings) > 0 {
					@ui.Alert("gold", "status") {
						<span class="bold">{ i18n.N(ctx, "scripts.publish.warnings", int64(len(v.Warnings))) }</span>
						<span>{ i18n.T(ctx, "scripts.publish.confirm_note") }</span>
					}
				} else {
					@ui.Alert("pine", "status") {
						{ i18n.T(ctx, "scripts.publish.clean") }
					}
				}
				if len(v.Errors)+len(v.Warnings) > 0 {
					<ul class="warnlist pub-list">
						for _, p := range append(append([]panelProblem{}, v.Errors...), v.Warnings...) {
							<li>
								<span class={ "st", sevClass(p.Sev) } aria-hidden="true"></span>
								if p.Line > 0 {
									<span class="bold">{ i18n.T(ctx, "scripts.panel.line", i18n.Args{"line": strconv.Itoa(p.Line)}) }</span>
								}
								<span class="subtle">{ p.Text }</span>
							</li>
						}
					</ul>
				}
				<div class="field">
					<label for="pub-notes">{ i18n.T(ctx, "scripts.publish.notes") }</label>
					<textarea id="pub-notes" name="notes" class="pc-inp pc-ta" rows="3" maxlength="500" placeholder={ i18n.T(ctx, "scripts.publish.notes_ph") }>{ v.Notes }</textarea>
					@fieldErr(v.NotesErr)
				</div>
				if len(v.Errors) == 0 && len(v.Warnings) > 0 {
					<div class="field">
						<label class="check"><input type="checkbox" name="confirm" value="1" checked?={ v.Confirm }/> { i18n.T(ctx, "scripts.publish.tick") }</label>
						if v.Unticked {
							<p class="err" role="alert">{ i18n.T(ctx, "scripts.publish.need_tick") }</p>
						}
					</div>
				}
				<div>
					<div class="lbl">{ i18n.T(ctx, "scripts.publish.happens") }</div>
					<ul class="dlg-list pub-happens">
						<li>{ i18n.T(ctx, "scripts.publish.h1", i18n.Args{"version": strconv.Itoa(v.Next)}) }</li>
						if v.Next == 1 {
							<li>{ i18n.T(ctx, "scripts.publish.h_slug", i18n.Args{"slug": v.S.Slug}) }</li>
						}
						<li>{ i18n.N(ctx, "scripts.publish.h2", int64(v.Generations)) }</li>
					</ul>
				</div>
				<div class="form-actions">
					<button type="submit" class="pc-btn pc-pri" data-action="rs.publish_go" disabled?={ len(v.Errors) > 0 }>{ i18n.T(ctx, "scripts.publish.go", i18n.Args{"version": strconv.Itoa(v.Next)}) }</button>
					<a href={ templ.SafeURL(ScriptHref(v.S.ID) + "#draft") } class="pc-btn pc-ghost">{ i18n.T(ctx, "ui.cancel") }</a>
				</div>
			</form>
		}
	}
}
