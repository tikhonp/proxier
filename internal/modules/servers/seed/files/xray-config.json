{
  "log": { "loglevel": "warning" },
  "inbounds": [
    {
      "tag": "vless-xhttp",
      "port": 10001,
      "protocol": "vless",
      "settings": {
        "clients": [{{ range $i, $c := .Clients }}{{ if $i }},{{ end }}{ "id": {{ json $c.ID }}, "email": {{ json $c.Name }} }{{ end }}],
        "decryption": "none"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "none",
        "xhttpSettings": {
          "path": {{ json .Gen.xhttp_path }},
          "mode": "auto",
          "extra": {
            "xPaddingBytes": "100-1000"
          }
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct-outbound",
      "protocol": "freedom"
    }
  ]
}
