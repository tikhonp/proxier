package pages

import (
	"strconv"

	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/ui"
)

// ---------------------------------------------------------- new server

templ newServerPage(s ui.Shell, v newView) {
	@ui.Layout(s) {
		<div class="titleblock">
			<div class="head">
				<nav class="crumbs" aria-label="Breadcrumb"><a href="/servers">{ i18n.T(ctx, "servers.title") }</a><span aria-hidden="true">/</span><span>{ i18n.T(ctx, "servers.new") }</span></nav>
				<h1>{ i18n.T(ctx, "servers.new") }</h1>
				<p class="subtle">{ i18n.T(ctx, "servers.new.note") }</p>
			</div>
		</div>
		if v.NoTemplates {
			@ui.EmptyState(i18n.T(ctx, "servers.new.no_templates"), i18n.T(ctx, "servers.new.no_templates_next"))
		} else {
			<form
				method="post"
				action="/servers"
				class="newcols"
				hx-post="/servers/new/summary"
				hx-trigger="input delay:300ms, change"
				hx-target="#summary"
				hx-swap="innerHTML"
				hx-params="not root_password"
			>
				<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
				<div class="newform form">
					if len(v.Errs) > 0 {
						@ui.Alert("love", "alert") {
							{ i18n.T(ctx, "servers.new.refused") }
						}
					}
					<h2 class="grp">{ i18n.T(ctx, "servers.new.access") }</h2>
					<div class="field">
						<label for="srv-ip">{ i18n.T(ctx, "servers.new.ip") }</label>
						<input id="srv-ip" class="pc-inp" name="ip" value={ v.IP } autocomplete="off" spellcheck="false" inputmode="decimal" placeholder="203.0.113.24" aria-invalid?={ v.Errs["ip"] != "" }/>
						if v.Errs["ip"] != "" {
							<p class="err" role="alert">{ v.Errs["ip"] }</p>
						}
						<p class="help">{ i18n.T(ctx, "servers.new.ip.help") }</p>
					</div>
					<details open?={ v.SSHIP != "" || v.Errs["ssh_ip"] != "" }>
						<summary>{ i18n.T(ctx, "servers.new.network") }</summary>
						<div class="field">
							<label for="srv-ssh-ip">{ i18n.T(ctx, "servers.new.ssh_ip") }</label>
							<input id="srv-ssh-ip" class="pc-inp" name="ssh_ip" value={ v.SSHIP } placeholder="100.64.0.10" autocomplete="off" spellcheck="false" aria-invalid?={ v.Errs["ssh_ip"] != "" }/>
							if v.Errs["ssh_ip"] != "" {
								<p class="err" role="alert">{ v.Errs["ssh_ip"] }</p>
							}
							<p class="help">{ i18n.T(ctx, "servers.new.ssh_ip.help") }</p>
						</div>
					</details>
					<div class="field">
						<label for="srv-access">{ i18n.T(ctx, "servers.new.access.how") }</label>
						<select id="srv-access" class="pc-inp" name="access" aria-invalid?={ v.Errs["access"] != "" }>
							<option value="password" selected?={ v.Access != "key" }>{ i18n.T(ctx, "servers.new.access.password") }</option>
							<option value="key" selected?={ v.Access == "key" }>{ i18n.T(ctx, "servers.new.access.key") }</option>
						</select>
						if v.Errs["access"] != "" {
							<p class="err" role="alert">{ v.Errs["access"] }</p>
						}
					</div>
					<div class={ "field", templ.KV("hidden", v.Access == "key") } data-depends="access" data-when="password">
						<label for="srv-pw">{ i18n.T(ctx, "servers.new.password") }</label>
						<input id="srv-pw" class="pc-inp" type="password" name="root_password" autocomplete="new-password" disabled?={ v.Access == "key" } aria-invalid?={ v.Errs["root_password"] != "" }/>
						if v.Errs["root_password"] != "" {
							<p class="err" role="alert">{ v.Errs["root_password"] }</p>
						} else {
							<p class="help">{ i18n.T(ctx, "servers.new.password.help") }</p>
						}
					</div>
					<div class={ "field", templ.KV("hidden", v.Access != "key") } data-depends="access" data-when="key">
						<label for="srv-user">{ i18n.T(ctx, "servers.new.ssh_user") }</label>
						<input id="srv-user" class="pc-inp" name="ssh_user" value={ v.SSHUser } disabled?={ v.Access != "key" } autocomplete="off" spellcheck="false" autocapitalize="none" aria-invalid?={ v.Errs["ssh_user"] != "" }/>
						if v.Errs["ssh_user"] != "" {
							<p class="err" role="alert">{ v.Errs["ssh_user"] }</p>
						} else {
							<p class="help">{ i18n.T(ctx, "servers.new.ssh_user.help") }</p>
						}
					</div>
					<details class="srv-options" open?={ v.Setup == "minimal" || v.Port != "" && v.Port != "22" || v.Errs["setup"] != "" || v.Errs["ssh_port"] != "" }>
						<summary>
							{ i18n.T(ctx, "servers.new.options") }
							<span class={ "sm subtle", templ.KV("hidden", v.Setup == "minimal") } data-depends="setup" data-when="full"> · { i18n.T(ctx, "servers.setup.full") }</span>
							<span class={ "sm subtle", templ.KV("hidden", v.Setup != "minimal") } data-depends="setup" data-when="minimal"> · { i18n.T(ctx, "servers.new.setup.minimal") }</span>
						</summary>
						<div class="field">
							<label for="srv-setup">{ i18n.T(ctx, "servers.new.setup") }</label>
							<select id="srv-setup" class="pc-inp" name="setup" aria-invalid?={ v.Errs["setup"] != "" }>
								<option value="full" selected?={ v.Setup != "minimal" }>{ i18n.T(ctx, "servers.new.setup.full") }</option>
								<option value="minimal" selected?={ v.Setup == "minimal" }>{ i18n.T(ctx, "servers.new.setup.minimal") }</option>
							</select>
							if v.Errs["setup"] != "" {
								<p class="err" role="alert">{ v.Errs["setup"] }</p>
							}
							<p class={ "help", templ.KV("hidden", v.Setup == "minimal") } data-depends="setup" data-when="full">{ i18n.T(ctx, "servers.new.setup.full.help") }</p>
							<p class={ "help", templ.KV("hidden", v.Setup != "minimal") } data-depends="setup" data-when="minimal">{ i18n.T(ctx, "servers.new.setup.minimal.help") }</p>
						</div>
						<div class="field">
							<label for="srv-port">{ i18n.T(ctx, "servers.new.port") }</label>
							<input id="srv-port" class="pc-inp" name="ssh_port" value={ v.Port } placeholder="22" inputmode="numeric" autocomplete="off" aria-invalid?={ v.Errs["ssh_port"] != "" }/>
							if v.Errs["ssh_port"] != "" {
								<p class="err" role="alert">{ v.Errs["ssh_port"] }</p>
							}
						</div>
					</details>
					<h2 class="grp">{ i18n.T(ctx, "servers.new.country") }</h2>
					@countryPick(v, false)
					<datalist id="countries">
						for _, label := range v.Countries {
							<option value={ label }></option>
						}
					</datalist>
					<div class="field">
						<label for="srv-host">
							{ i18n.T(ctx, "servers.new.hostname") }
							<span class="sm subtle">· { i18n.T(ctx, "servers.new.optional") }</span>
						</label>
						<input id="srv-host" class="pc-inp" name="hostname" value={ v.Hostname } placeholder="vpn.example.com" autocomplete="off" spellcheck="false" autocapitalize="none" aria-invalid?={ v.Errs["hostname"] != "" }/>
						if v.Errs["hostname"] != "" {
							<p class="err" role="alert">{ v.Errs["hostname"] }</p>
						} else {
							<p class="help">{ i18n.T(ctx, "servers.new.hostname.help") }</p>
						}
					</div>
					<h2 class="grp">{ i18n.T(ctx, "servers.new.addresses") }</h2>
					<div class="field">
						<div id="addr-rows">
							for i, a := range v.Addresses {
								<div data-addr-entry>
									<div class="inline" data-addr-row>
										<input class="pc-inp" name="add_ip" value={ a.IP } placeholder="203.0.113.25" autocomplete="off" spellcheck="false" inputmode="decimal" aria-label={ i18n.T(ctx, "servers.new.addr.ip") } aria-invalid?={ v.Errs["addr_ip_" + strconv.Itoa(i)] != "" }/>
										<input class="pc-inp" name="add_host" value={ a.Hostname } placeholder="alt.example.com" autocomplete="off" spellcheck="false" autocapitalize="none" aria-label={ i18n.T(ctx, "servers.new.addr.hostname") } aria-invalid?={ v.Errs["addr_host_" + strconv.Itoa(i)] != "" }/>
										<button type="button" class="pc-btn pc-sm pc-ghost" data-addr-remove>{ i18n.T(ctx, "servers.new.addr.remove") }</button>
									</div>
									if err := v.Errs["addr_ip_" + strconv.Itoa(i)]; err != "" {
										<p class="err" role="alert">{ err }</p>
									}
									if err := v.Errs["addr_host_" + strconv.Itoa(i)]; err != "" {
										<p class="err" role="alert">{ err }</p>
									}
								</div>
							}
						</div>
						<button type="button" class="pc-btn pc-sm" data-addr-add>{ i18n.T(ctx, "servers.new.addr.add") }</button>
						<p class="help">{ i18n.T(ctx, "servers.new.addresses.help") }</p>
					</div>
					<h2 class="grp">{ i18n.T(ctx, "servers.new.template") }</h2>
					<div class="field">
						<label for="srv-tpl">{ i18n.T(ctx, "servers.new.template") }</label>
						<div class="inline">
							<select id="srv-tpl" class="pc-inp" name="template">
								for _, t := range v.Templates {
									<option value={ strconv.FormatInt(t.ID, 10) } selected?={ t.Selected }>{ t.Name }</option>
								}
							</select>
							@versionPick(v, false)
						</div>
						for _, k := range []string{"template", "version"} {
							if v.Errs[k] != "" {
								<p class="err" role="alert">{ v.Errs[k] }</p>
							}
						}
					</div>
					@paramsArea(v, false)
					<div class="field">
						<label for="srv-notes">{ i18n.T(ctx, "servers.new.notes") }</label>
						<textarea id="srv-notes" class="pc-inp" name="notes" rows="3" placeholder={ i18n.T(ctx, "servers.new.notes.placeholder") }>{ v.Notes }</textarea>
						if v.Errs["notes"] != "" {
							<p class="err" role="alert">{ v.Errs["notes"] }</p>
						}
					</div>
					<div class="form-actions">
						<button type="submit" class="pc-btn pc-pri">{ v.CreateLabel }</button>
						<a href="/servers" class="pc-btn pc-ghost" data-cancel>{ i18n.T(ctx, "ui.cancel") }</a>
						<span class="sm subtle">{ i18n.T(ctx, "servers.new.create.note") }</span>
					</div>
				</div>
				<aside class="newsum" aria-labelledby="sum-h">
					<div class="stick">
						<h2 id="sum-h">{ i18n.T(ctx, "servers.new.summary") }</h2>
						<div id="summary">
							@summaryBody(v)
						</div>
						if v.Errs["dns"] != "" {
							<p class="err" role="alert">{ v.Errs["dns"] }</p>
						}
					</div>
				</aside>
			</form>
		}
	}
}

// countryPick is the country picker: a field that searches the list of
// countries (the datalist beside it, left out of the swap so the summary's
// answer stays small), the country the IP suggested last and the hint. As the
// answer to the summary it swaps itself out of band (oob), and only when the
// IP suggests another country into a field the admin hasn't chosen in.
templ countryPick(v newView, oob bool) {
	<div id="country-pick" class="field" if oob { hx-swap-oob="true" }>
		<label for="srv-country">{ i18n.T(ctx, "servers.new.country") }</label>
		<input
			id="srv-country"
			class="pc-inp"
			name="country"
			list="countries"
			value={ v.Country }
			placeholder={ i18n.T(ctx, "servers.new.country.placeholder") }
			autocomplete="off"
			spellcheck="false"
			aria-describedby="country-hint"
			aria-invalid?={ v.Errs["country"] != "" }
		/>
		<input type="hidden" name="country_auto" value={ v.Auto }/>
		@countryHint(v, false)
	</div>
}

// countryHint is the line under the picker: an error, the IP's suggestion
// while it stands, or the help. The summary swaps it alone when it keeps the
// field, so a suggestion the admin has since overridden no longer shows.
templ countryHint(v newView, oob bool) {
	if v.Errs["country"] != "" {
		<p class="err" role="alert" id="country-hint" if oob { hx-swap-oob="true" }>{ v.Errs["country"] }</p>
	} else if v.Hint != "" {
		<p class="help" id="country-hint" if oob { hx-swap-oob="true" }>{ v.Hint }</p>
	} else {
		<p class="help" id="country-hint" if oob { hx-swap-oob="true" }>{ i18n.T(ctx, "servers.new.country.help") }</p>
	}
}

templ versionPick(v newView, oob bool) {
	<select id="srv-ver" class="pc-inp" name="version" aria-label={ i18n.T(ctx, "servers.new.version") } if oob { hx-swap-oob="true" }>
		for _, ver := range v.Versions {
			<option value={ strconv.Itoa(ver.Number) } selected?={ ver.Selected }>{ ver.Label }</option>
		}
	</select>
}

// paramsArea holds the parameters of the chosen version, and the key that says
// for which version they were made.
templ paramsArea(v newView, oob bool) {
	<div id="params" if oob { hx-swap-oob="true" }>
		<input type="hidden" id="params_for" name="params_for" value={ v.ParamsFor }/>
		@paramInputs(v.Params)
	</div>
}

// paramInputs are the fields of a version's parameters.
templ paramInputs(fields []paramField) {
	for _, p := range fields {
		<div class="field">
			<label for={ "p-" + p.Name }>
				{ p.Label }
				if !p.Required {
					<span class="sm subtle">· { i18n.T(ctx, "servers.new.optional") }</span>
				}
			</label>
			switch p.Type {
				case "bool":
					<select id={ "p-" + p.Name } class="pc-inp" name={ p.Name }>
						<option value="false" selected?={ p.Value != "true" }>{ i18n.T(ctx, "servers.no") }</option>
						<option value="true" selected?={ p.Value == "true" }>{ i18n.T(ctx, "servers.yes") }</option>
					</select>
				case "choice":
					<select id={ "p-" + p.Name } class="pc-inp" name={ p.Name }>
						for _, o := range p.Options {
							<option value={ o } selected?={ o == p.Value }>{ o }</option>
						}
					</select>
				case "text":
					<textarea id={ "p-" + p.Name } class="pc-inp" name={ p.Name } rows="4" aria-invalid?={ p.Err != "" }>{ p.Value }</textarea>
				default:
					<input
						id={ "p-" + p.Name }
						class="pc-inp"
						name={ p.Name }
						value={ p.Value }
						type={ p.inputType() }
						inputmode={ p.inputMode() }
						autocomplete="off"
						spellcheck="false"
						aria-invalid?={ p.Err != "" }
					/>
			}
			if p.Err != "" {
				<p class="err" role="alert">{ p.Err }</p>
			} else if p.Help != "" {
				<p class="help">{ p.Help }</p>
			}
		</div>
	}
}

templ summaryBody(v newView) {
	if v.Sum.Name == "" {
		<p class="subtle">{ i18n.T(ctx, "servers.new.summary.empty") }</p>
	} else {
		<dl class="kv">
			<dt>{ i18n.T(ctx, "servers.new.sum.name") }</dt>
			<dd>
				<span class="bold">{ v.Sum.Name }</span>
				<div class="sm subtle">{ i18n.T(ctx, "servers.new.sum.name.note") }</div>
			</dd>
			if v.Sum.SSHIP != "" {
				<dt>{ i18n.T(ctx, "servers.new.ssh_ip") }</dt>
				<dd>{ v.Sum.SSHIP }</dd>
			}
			<dt>{ i18n.T(ctx, "servers.new.sum.host") }</dt>
			<dd>
				{ v.Sum.ManagementHostname }
				<div class="sm subtle">{ i18n.T(ctx, "servers.new.sum.host.note") }</div>
			</dd>
			<dt>{ i18n.T(ctx, "servers.new.sum.dns") }</dt>
			<dd>
				{ v.Sum.DNSRecord }
				if v.Sum.ManualDNS {
					<div class="sm subtle">{ i18n.T(ctx, "servers.new.sum.dns.manual") }</div>
					if v.Sum.DNSFound != "" {
						<div class="sm" role="status">{ i18n.T(ctx, "servers.new.sum.dns.found", i18n.Args{"said": v.Sum.DNSFound}) }</div>
					}
					<button
						type="button"
						disabled?={ v.SkipDNS }
						class="pc-btn pc-sm"
						hx-post="/servers/new/summary"
						hx-vals='{"check_dns": "1"}'
						hx-params="not root_password"
						hx-target="#summary"
						hx-swap="innerHTML"
						data-action="srv.check_dns"
					>{ i18n.T(ctx, "servers.new.sum.dns.check") }</button>
					<div class="field">
						<label class="check"><input type="checkbox" name="skip_dns" value="1" checked?={ v.SkipDNS } aria-describedby="skip-dns-help"/> <span>{ i18n.T(ctx, "servers.new.skip_dns") }</span></label>
						<p id="skip-dns-help" class="help">{ i18n.T(ctx, "servers.new.skip_dns.help") }</p>
					</div>
				} else {
					<div class="sm subtle">proxier:{ v.Sum.Name }</div>
				}
			</dd>
			if len(v.Sum.Addresses) > 0 {
				<dt>{ i18n.T(ctx, "servers.new.sum.addresses") }</dt>
				<dd>
					for _, a := range v.Sum.Addresses {
						<div>{ a }</div>
					}
					<div class="sm subtle">{ i18n.T(ctx, "servers.new.sum.addresses.note") }</div>
				</dd>
			}
			<dt>{ i18n.T(ctx, "servers.new.sum.endpoints") }</dt>
			<dd>
				for _, e := range v.Sum.Endpoints {
					<div>{ i18n.T(ctx, "servers.new.sum.shown_as") } “{ e }”</div>
				}
			</dd>
		</dl>
	}
	if len(v.SumErrors) > 0 {
		<h3 class="grp">{ i18n.T(ctx, "servers.new.sum.look") }</h3>
		<ul class="warnlist">
			for _, e := range v.SumErrors {
				<li>{ e }</li>
			}
		</ul>
	}
}

// summaryFragment is the live summary's answer: the panel, and, out of band,
// the fields the new state changes.
templ summaryFragment(v newView, params, country bool) {
	@summaryBody(v)
	if country {
		@countryPick(v, true)
	} else {
		@countryHint(v, true)
	}
	if params {
		@versionPick(v, true)
		@paramsArea(v, true)
	}
}

// --------------------------------------------------------- the server page

templ serverTabs(v serverView, tab string) {
	<nav class="tabs" aria-label={ i18n.T(ctx, "servers.tabs") }>
		<a href={ templ.SafeURL(serverHref(v.S.ID)) } if tab == "overview" { aria-current="page" }>{ i18n.T(ctx, "servers.tab.overview") }</a>
		if v.S.State == "active" && !v.Retiring {
			<a href={ templ.SafeURL(serverHref(v.S.ID) + "/health") } if tab == "health" { aria-current="page" }>{ i18n.T(ctx, "servers.tab.health") }</a>
			<a href={ templ.SafeURL(serverHref(v.S.ID) + "/stats") } if tab == "stats" { aria-current="page" }>{ i18n.T(ctx, "servers.tab.stats") }</a>
		}
		if v.S.State != "provisioning" {
			<a href={ templ.SafeURL(serverHref(v.S.ID) + "/stack") } if tab == "stack" { aria-current="page" }>{ i18n.T(ctx, "servers.tab.stack") }</a>
		}
		<a href={ templ.SafeURL("/jobs?subject=server:" + strconv.FormatInt(v.S.ID, 10)) }>{ i18n.T(ctx, "servers.tab.jobs") }</a>
		<a href={ templ.SafeURL("/activity?subject=server:" + strconv.FormatInt(v.S.ID, 10)) }>{ i18n.T(ctx, "servers.tab.activity") }</a>
	</nav>
}

// serverHead is the title block and the tabs every tab of a server shares.
templ serverHead(v serverView, tab string) {
	<div class="titleblock">
		<div class="head">
			<nav class="crumbs" aria-label="Breadcrumb"><a href="/servers">{ i18n.T(ctx, "servers.title") }</a><span aria-hidden="true">/</span><span>{ v.S.Name }</span></nav>
			<div class="jobtitle">
				<h1>{ v.Flag } { v.S.Name }</h1>
				@ui.Status(v.Kind, v.Word)
				if v.Reason != "" {
					<span class="sm subtle">{ v.Reason }</span>
				}
			</div>
			<p class="subtle facts"><span>{ countryName(ctx, v.S.Country) }</span> · <span>{ v.S.IP }</span> · <span title={ v.S.ManagementHostname }>{ v.S.ManagementHostname }</span></p>
			if v.S.SSHIP != "" {
				<p class="sm subtle">{ i18n.T(ctx, "servers.new.ssh_ip") }: { v.S.SSHIP }</p>
			}
		</div>
		<div class="actions">
			if v.CanCancel {
				@ui.ActionButton(ui.Action{
					ID: "server.cancel", Label: "servers.cancel", Method: "POST", Href: serverHref(v.S.ID) + "/cancel",
					Confirm: &ui.Confirm{Strength: 1, Title: i18n.T(ctx, "servers.cancel"), Body: i18n.T(ctx, "servers.cancel.body")},
				})
			}
			if v.CanRetry {
				@ui.ActionButton(ui.Action{ID: "server.retry", Label: "servers.retry", Method: "GET", Href: serverHref(v.S.ID) + "/retry", Kind: ui.Primary, Key: "r"})
			}
			if v.CanActivateAnyway {
				@ui.ActionButton(ui.Action{
					ID: "server.activate", Label: "servers.activate", Method: "POST", Href: serverHref(v.S.ID) + "/activate",
					Confirm: &ui.Confirm{
						Strength: 2, Title: i18n.T(ctx, "servers.activate.title", i18n.Args{"name": v.S.Name}), Body: v.S.FailedError,
						Consequences: []string{i18n.T(ctx, "servers.activate.c1"), i18n.T(ctx, "servers.activate.c2")},
					},
				})
			}
			if v.RetireFailed {
                @ui.ActionButton(ui.Action{ID: "server.retire.skip_stack", Label: "servers.retire.skip_stack", Method: "POST", Href: serverHref(v.S.ID) + "/retire/retry?skip_stack=1", Confirm: &ui.Confirm{Strength: 2, Title: i18n.T(ctx, "servers.retire.skip_stack"), Body: i18n.T(ctx, "servers.retire.skip_stack.body")}})
				@ui.ActionButton(ui.Action{ID: "server.retire.retry", Label: "servers.retire.retry", Method: "POST", Href: serverHref(v.S.ID) + "/retire/retry", Kind: ui.Primary, Key: "r"})
			}
			if v.S.State == "active" && !v.Retiring && tab != "health" {
				@ui.ActionButton(ui.Action{ID: "health.run", Label: "health.run", Method: "POST", Href: serverHref(v.S.ID) + "/checks/run", Key: "r"})
			}
			if v.S.State == "active" && !v.Retiring {
				@ui.ActionButton(ui.Action{ID: "server.redeploy", Label: "servers.act.redeploy", Method: "GET", Href: serverHref(v.S.ID) + "/redeploy", Kind: ui.Primary, Key: "d"})
			}
			if !v.Retiring && !v.Retired {
				@ui.ActionButton(ui.Action{ID: "server.retire", Label: "servers.retire", Method: "GET", Href: serverHref(v.S.ID) + "/retire", Kind: ui.Danger, Key: "x"})
			}
		</div>
	</div>
	@serverTabs(v, tab)
}

// jobPanel is the steps and the live log of a job on the server's page.
templ jobPanel(j *jobSide, title string) {
	<div class="jobcols">
		<aside class="jobside">
			<section>
				<div class="pc-title"><h2>{ title }</h2></div>
				@ui.JobSteps(j.Steps)
			</section>
		</aside>
		<section class="jobmain" aria-labelledby="srv-log-h">
			<div class="pc-title">
				<h2 id="srv-log-h">{ i18n.T(ctx, "job.log") }</h2>
				<span class="flex1"></span>
				@ui.LogTools(j.Stream != "")
				<a class="pc-btn pc-sm" href={ templ.SafeURL(j.Href) }>{ i18n.T(ctx, "servers.provision.open_job") }</a>
			</div>
			@ui.JobLog(j.Stream, j.Reload, j.Lines)
		</section>
	</div>
}

templ serverOverviewPage(s ui.Shell, v serverView) {
	@ui.Layout(s) {
		@serverHead(v, "overview")
		if v.Saved {
			@ui.Alert("pine", "status") {
				{ i18n.T(ctx, "servers.notes.saved") }
			}
		}
		if v.Retired {
			@ui.Band("iris") {
				<span class="bold">{ i18n.T(ctx, "servers.retired.on", i18n.Args{"date": v.RetiredOn}) }</span>
				<span>{ i18n.T(ctx, "servers.retired.note") }</span>
			}
		}
		if v.Retiring && !v.RetireFailed {
			@ui.Band("gold") {
				<span class="bold">{ i18n.T(ctx, "servers.retiring.title") }</span>
				<span>{ i18n.T(ctx, "servers.retiring.note") }</span>
			}
		}
		if v.RetireFailed {
			@ui.Band("love") {
				<span class="bold">{ i18n.T(ctx, "servers.retire.failed_at", i18n.Args{"step": v.RetireStep}) }</span>
				<span>{ v.RetireErr }</span>
				<span class="subtle">{ i18n.T(ctx, "servers.retire.failed_note") }</span>
			}
		}
		if v.RetireJob != nil {
			@jobPanel(v.RetireJob, i18n.T(ctx, "servers.retire.steps"))
		}
		if v.S.State == "failed" && !v.Retiring {
			@ui.Band("love") {
				<span class="bold">{ i18n.T(ctx, "servers.failed.at", i18n.Args{"step": i18n.T(ctx, "job.servers.provision.step."+v.S.FailedStep)}) }</span>
				<span>{ v.S.FailedError }</span>
			}
		}
		if v.Rollback != nil {
			@ui.Band("gold") {
				<span class="bold">{ i18n.T(ctx, "servers.rollback.band", i18n.Args{"kind": v.Rollback.Kind}) }</span>
				<span>{ v.Rollback.Error }</span>
				<a class="pc-btn pc-sm" href={ templ.SafeURL(v.Rollback.JobHref) }>{ i18n.T(ctx, "servers.provision.open_job") }</a>
			}
		}
		if v.Job != nil {
			@jobPanel(v.Job, i18n.T(ctx, "servers.provision.steps"))
		}
		if v.Change != nil {
			@jobPanel(v.Change, i18n.T(ctx, "servers.change.steps"))
		}
		if len(v.Actions) > 0 {
			@ui.Area(i18n.T(ctx, "servers.area.actions"), "") {
				<div class="area-body actions-row">
					for _, a := range v.Actions {
						@ui.ActionButton(a)
					}
				</div>
			}
		}
		@ui.Area(i18n.T(ctx, "servers.area.identity"), "") {
			<dl class="kv area-body">
				<dt>{ i18n.T(ctx, "servers.kv.country") }</dt>
				<dd>{ v.Flag } { countryName(ctx, v.S.Country) } · { v.S.Country }</dd>
				<dt>{ i18n.T(ctx, "servers.kv.ip") }</dt>
				<dd>{ v.S.IP }:{ strconv.Itoa(v.S.SSHPort) }</dd>
				<dt>{ i18n.T(ctx, "servers.kv.access") }</dt>
				<dd>
					if v.S.KeyAccess() {
						{ i18n.T(ctx, "servers.access.key", i18n.Args{"user": v.S.LoginUser()}) }
					} else {
						{ i18n.T(ctx, "servers.access.password") }
					}
					<span class="sm subtle">· { i18n.T(ctx, "servers.setup." + v.S.Setup) }</span>
				</dd>
				if len(v.Previous) > 0 {
					<dt>{ i18n.T(ctx, "servers.kv.previous") }</dt>
					<dd>
						for i, p := range v.Previous {
							if i > 0 {
								<span>, </span>
							}
							<a href={ templ.SafeURL(serverHref(v.S.ID) + "/health") }>{ p.IP }</a> <span class="sm subtle">{ i18n.T(ctx, "servers.previous.state." + p.State) }</span>
						}
					</dd>
				}
				<dt>{ i18n.T(ctx, "servers.kv.hosts") }</dt>
				<dd>
					{ v.S.ManagementHostname }
					if v.S.ProxyHostname != v.S.ManagementHostname {
						· { v.S.ProxyHostname }
					}
				</dd>
				if len(v.Addresses) > 0 {
					<dt>{ i18n.T(ctx, "servers.kv.addresses") }</dt>
					<dd>
						for _, a := range v.Addresses {
							<div>{ a.IP } · { a.Hostname }</div>
						}
					</dd>
				}
				<dt>{ i18n.T(ctx, "servers.kv.template") }</dt>
				<dd>
					<a href={ templ.SafeURL(tplHref(v.S.TemplateID)) }>{ v.S.TemplateName }</a> { vlabel(v.S.TemplateVersion) }
					if v.UpdateTo > 0 {
						<span class="sm subtle">· <a href={ templ.SafeURL(serverHref(v.S.ID) + "/upgrade?version=" + strconv.Itoa(v.UpdateTo)) }>{ i18n.T(ctx, "servers.update_available", i18n.Args{"version": vlabel(v.UpdateTo)}) }</a></span>
					}
				</dd>
				<dt>{ i18n.T(ctx, "servers.kv.subscriptions") }</dt>
				<dd>{ v.Usage }</dd>
				<dt>{ i18n.T(ctx, "servers.kv.created") }</dt>
				<dd>{ v.Created }</dd>
				if v.Active != "" {
					<dt>{ i18n.T(ctx, "servers.kv.activated") }</dt>
					<dd>{ v.Active }</dd>
				}
			</dl>
		}
		if len(v.Endpoints) > 0 {
			@ui.Area(i18n.T(ctx, "servers.area.endpoints"), i18n.T(ctx, "servers.area.endpoints.note")) {
				for _, e := range v.Endpoints {
					<div class="row ep" id={ "ep-" + e.Key }>
						<span class="bold">{ e.Display }</span>
						<span class="subtle facts"><span>{ e.Key }</span> · <span>{ e.Type }</span> · <span title={ e.Address }>{ e.Address }</span></span>
						<span class="uri" id={ "uri-" + e.Key }>
							<code class="masked">vless://••••••••@{ e.Address }</code>
							<button type="button" class="pc-btn pc-sm" hx-get={ e.URIHref } hx-target={ "#uri-" + e.Key } hx-swap="innerHTML">{ i18n.T(ctx, "servers.ep.reveal") }</button>
							<button type="button" class="pc-btn pc-sm" hx-get={ e.QRHref } hx-target="#qr-slot" hx-swap="innerHTML">{ i18n.T(ctx, "servers.ep.qr") }</button>
						</span>
					</div>
				}
				<div id="qr-slot"></div>
			}
		}
		@ui.Area(i18n.T(ctx, "servers.area.notes"), "") {
			if v.Retired {
				<p class="area-body">{ v.S.Notes }</p>
			} else {
			<form method="post" action={ serverHref(v.S.ID) + "/notes" } class="form area-body">
				<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
				<div class="field">
					<textarea class="pc-inp" name="notes" rows="3" aria-label={ i18n.T(ctx, "servers.area.notes") } placeholder={ i18n.T(ctx, "servers.new.notes.placeholder") }>{ v.S.Notes }</textarea>
					if v.Err != "" {
						<p class="err" role="alert">{ v.Err }</p>
					}
				</div>
				<div class="form-actions">
					<button type="submit" class="pc-btn pc-sm">{ i18n.T(ctx, "servers.notes.save") }</button>
				</div>
			</form>
			}
		}
		@ui.Area(i18n.T(ctx, "servers.area.events"), "") {
			if len(v.Events) == 0 {
				<p class="subtle area-body">{ i18n.T(ctx, "servers.events.none") }</p>
			}
			for _, e := range v.Events {
				<div class="row evt"><span class="subtle">{ e.Time }</span><span>{ e.Text }</span></div>
			}
		}
	}
}

// uriRevealed replaces the masked URI after Reveal: the URI, a copy button
// holding it and the QR button. The answer is never cached.
templ uriRevealed(v uriView) {
	<code class="uri-full" id={ "uri-text-" + v.Key }>{ v.URI }</code>
	<button type="button" class="pc-btn pc-sm" data-copy={ v.URI }>{ i18n.T(ctx, "servers.copy") }</button>
	<button type="button" class="pc-btn pc-sm" hx-get={ v.QRHref } hx-target="#qr-slot" hx-swap="innerHTML">{ i18n.T(ctx, "servers.ep.qr") }</button>
}

// qrDialog is the QR code of an endpoint's URI in a dialog that opens itself.
templ qrDialog(name, uri string) {
	<dialog id="qr-dialog" class="pc-dialog" data-autoopen="true" aria-labelledby="qr-dialog-h">
		<div class="dlg-title">
			<h2 id="qr-dialog-h">{ name }</h2>
			<button type="button" class="pc-seg pc-close" data-dialog-close aria-label={ i18n.T(ctx, "ui.close") }>×</button>
		</div>
		<div class="dlg-body">
			@ui.QR(uri, i18n.T(ctx, "servers.ep.qr.label", i18n.Args{"name": name}))
			<p class="sm subtle">{ i18n.T(ctx, "servers.ep.qr.note") }</p>
		</div>
	</dialog>
}

// -------------------------------------------------------------------- retry

templ retryPage(s ui.Shell, v retryView) {
	@ui.Layout(s) {
		<div class="titleblock">
			<div class="head">
				<nav class="crumbs" aria-label="Breadcrumb"><a href="/servers">{ i18n.T(ctx, "servers.title") }</a><span aria-hidden="true">/</span><a href={ templ.SafeURL(serverHref(v.S.ID)) }>{ v.S.Name }</a><span aria-hidden="true">/</span><span>{ i18n.T(ctx, "servers.retry") }</span></nav>
				<h1>{ i18n.T(ctx, "servers.retry.title", i18n.Args{"name": v.S.Name}) }</h1>
				<p class="subtle">{ i18n.T(ctx, "servers.retry.note", i18n.Args{"step": i18n.T(ctx, "job.servers.provision.step."+v.S.FailedStep)}) }</p>
			</div>
		</div>
		@ui.Band("love") {
			<span class="bold">{ i18n.T(ctx, "servers.failed.at", i18n.Args{"step": i18n.T(ctx, "job.servers.provision.step."+v.S.FailedStep)}) }</span>
			<span>{ v.S.FailedError }</span>
		}
		<form method="post" action={ serverHref(v.S.ID) + "/retry" } class="form">
			<input type="hidden" name="_csrf" value={ ui.CSRF(ctx) }/>
			if v.NeedsPassword {
				<div class="field">
					<label for="rt-pw">{ i18n.T(ctx, "servers.new.password") }</label>
					<input id="rt-pw" class="pc-inp" type="password" name="root_password" autocomplete="new-password" autofocus aria-invalid?={ v.Errs["root_password"] != "" }/>
					if v.Errs["root_password"] != "" {
						<p class="err" role="alert">{ v.Errs["root_password"] }</p>
					} else {
						<p class="help">{ i18n.T(ctx, "servers.retry.password.help") }</p>
					}
				</div>
			}
			if v.Conflict {
				<div class="field">
					<label class="check"><input type="checkbox" name="overwrite_dns" value="1"/> { i18n.T(ctx, "servers.retry.overwrite") }</label>
					<p class="help">{ i18n.T(ctx, "servers.retry.overwrite.help") }</p>
				</div>
			}
			<div class="form-actions">
				<button type="submit" class="pc-btn pc-pri">{ i18n.T(ctx, "servers.retry") }</button>
				<a href={ templ.SafeURL(serverHref(v.S.ID)) } class="pc-btn pc-ghost" data-cancel>{ i18n.T(ctx, "ui.cancel") }</a>
				<span class="sm subtle">{ i18n.T(ctx, "servers.retry.keeps_version", i18n.Args{"version": v.S.TemplateVersion}) }</span>
			</div>
		</form>
	}
}

// dashboardServers is the servers area of the dashboard: home's banner, the
// fleet by health, the servers that need a look, updates and the top lists.
templ dashboardServers(v DashboardView) {
	if v.Home == "offline" {
		@ui.Band("love") {
			<span class="bold">{ i18n.T(ctx, "health.dash.home_offline") }</span>
			if v.HomeSince != "" {
				<span class="subtle">{ i18n.T(ctx, "servers.since", i18n.Args{"ago": v.HomeSince}) }</span>
			}
			<span>{ i18n.T(ctx, "health.dash.home_offline_body") }</span>
		}
	} else if v.Home == "foreign-unreachable" {
		@ui.Band("gold") {
			<span class="bold">{ i18n.T(ctx, "health.dash.foreign") }</span>
			if v.HomeSince != "" {
				<span class="subtle">{ i18n.T(ctx, "servers.since", i18n.Args{"ago": v.HomeSince}) }</span>
			}
			<span>{ i18n.T(ctx, "health.dash.foreign_body") }</span>
		}
	}
	if len(v.Checklist) > 0 {
		<div class="mx-group">{ i18n.T(ctx, "health.dash.setup") }</div>
		for _, c := range v.Checklist {
			<a href={ templ.SafeURL(c.Href) } class="row dashsrv pc-row">
				if c.Done {
					@ui.Status("ok", c.Label)
				} else {
					@ui.Status("off", c.Label)
				}
			</a>
		}
	}
	if v.Total > 0 {
		<div class="row dashsrv">
			// A count of zero is noise: the area says which states there are, not which there aren't.
			for _, st := range []string{"active", "provisioning", "failed"} {
				if v.Counts[st] > 0 {
					<span>
						<a href={ templ.SafeURL("/servers") } class="bold">{ strconv.Itoa(v.Counts[st]) }</a>
						<span class="subtle">{ i18n.T(ctx, "servers.state."+st) }</span>
					</span>
				}
			}
			<span class="flex1"></span>
			<a href="/servers" class="pc-btn pc-sm">{ i18n.T(ctx, "servers.dash.all") }</a>
		</div>
		if v.Counts["active"] > 0 {
			<div class="row dashcnt">
				for _, st := range []string{"healthy", "degraded", "blocked", "down", "unknown", "paused"} {
					if v.Health[st] > 0 {
						<span>
							@ui.Status(healthKind(st), i18n.T(ctx, "servers.health."+st))
							<span class="bold">{ strconv.Itoa(v.Health[st]) }</span>
						</span>
					}
				}
			</div>
		}
		for _, r := range v.NotHealthy {
			<a href={ templ.SafeURL(serverHref(r.ID)) } class="row dashsick pc-row">
				@ui.Status(r.Kind, "")
				<span class="bold">{ r.Flag } { r.Name }</span>
				<span>{ r.Reason }</span>
				<span class="sm subtle">{ r.Note }</span>
			</a>
		}
		for _, s := range v.Failed {
			<a href={ templ.SafeURL(serverHref(s.ID)) } class="row dashfail pc-row">
				@ui.Status("broken", i18n.T(ctx, "servers.state.failed"))
				<span class="bold">{ s.Name }</span>
				<span class="subtle">{ s.Reason }</span>
			</a>
		}
		if len(v.Updates) > 0 {
			<div class="mx-group">{ i18n.T(ctx, "health.dash.updates") }</div>
			for _, r := range v.Updates {
				<a href={ templ.SafeURL(serverHref(r.ID)) } class="row dashrank pc-row">
					<span class="bold">{ r.Flag } { r.Name }</span>
					<span class="subtle">{ r.Note }</span>
				</a>
			}
		}
		if len(v.TopDisk) > 0 {
			<div class="mx-group">{ i18n.T(ctx, "health.dash.top_disk") }</div>
			for _, r := range v.TopDisk {
				<a href={ templ.SafeURL(serverHref(r.ID) + "/stats") } class="row dashrank pc-row">
					<span class="bold">{ r.Name }</span>
					<span class="subtle">{ r.Value }</span>
				</a>
			}
		}
		if len(v.TopTraffic) > 0 {
			<div class="mx-group">{ i18n.T(ctx, "health.dash.top_traffic") }</div>
			for _, r := range v.TopTraffic {
				<a href={ templ.SafeURL(serverHref(r.ID) + "/stats") } class="row dashrank pc-row">
					<span class="bold">{ r.Name }</span>
					<span class="subtle">{ r.Value }</span>
				</a>
			}
		}
	}
}
