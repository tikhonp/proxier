package pages

import (
	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/settings"
	"github.com/tikhonp/proxier/internal/platform/ui"
)

templ serversSettingsPage(s ui.Shell, pages []ui.SettingsPage, sec settings.Section, v serversSettingsView) {
	@ui.SettingsLayout(s, pages, "servers") {
		<div class="set-head">
			<h2>{ i18n.T(ctx, "settings.servers") }</h2>
			<p>{ i18n.T(ctx, "servers.settings.note") }</p>
		</div>
		if v.Saved {
			<div class="form">
				@ui.Alert("pine", "status") {
					{ i18n.T(ctx, "ui.saved") }
				}
			</div>
		}
		if v.Warning != "" {
			<div class="form">
				@ui.Alert("gold", "alert") {
					{ v.Warning }
					{ " " }
					<a href="/settings/integrations/cloudflare">{ i18n.T(ctx, "servers.settings.zone_warning_link") }</a>
				}
			</div>
		}
		@ui.SettingsForm(sec, v.Values, v.Errs, "/settings/servers")
	}
}
