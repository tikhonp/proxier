package ui

import (
	"net/url"

	"github.com/tikhonp/proxier/internal/platform/i18n"
)

// SignIn is the standalone sign-in page: no shell, nothing but the form.
templ SignIn(v SignInView) {
	@page(i18n.T(ctx, "auth.sign_in"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			<form method="post" action="/login" aria-labelledby="si-h">
				<h1 id="si-h">{ i18n.T(ctx, "auth.sign_in") }</h1>
				switch v.Error {
					case "wrong":
						<div role="alert" class="alert love"><span class="st st-broken" aria-hidden="true"></span>{ i18n.T(ctx, "auth.wrong") }</div>
					case "code_expired":
						<div role="alert" class="alert gold"><span class="st st-look" aria-hidden="true"></span>{ i18n.T(ctx, "auth.code.expired") }</div>
					case "locked":
						<div role="status" class="alert gold"><span class="st st-look" aria-hidden="true"></span>{ i18n.N(ctx, "auth.locked", int64(v.LockedMin)) }</div>
				}
				if v.Ended != "" {
					<div role="status" class="alert">
						<span class="st st-unknown" aria-hidden="true"></span>
						if v.Next != "" && v.Next != "/" {
							{ i18n.T(ctx, "auth.ended."+v.Ended+".back", i18n.Args{"page": v.Next}) }
						} else {
							{ i18n.T(ctx, "auth.ended."+v.Ended) }
						}
					</div>
				}
				if v.Passkeys {
					<div role="alert" class="alert love hidden" id="pk-msg"><span class="st st-broken" aria-hidden="true"></span><span></span></div>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				<div>
					<label for="u" class="lbl">{ i18n.T(ctx, "auth.username") }</label>
					<input
						id="u"
						name="username"
						class="pc-inp"
						value={ v.Username }
						if v.Passkeys {
							autocomplete="username webauthn"
						} else {
							autocomplete="username"
						}
						autocapitalize="none"
						spellcheck="false"
						required
						autofocus?={ v.Username == "" }
					/>
				</div>
				<div>
					<label for="p" class="lbl">{ i18n.T(ctx, "auth.password") }</label>
					<input id="p" name="password" class="pc-inp" type="password" autocomplete="current-password" required autofocus?={ v.Username != "" }/>
				</div>
				<button type="submit" class="pc-btn pc-pri" disabled?={ v.Error == "locked" }>{ i18n.T(ctx, "auth.sign_in") }</button>
				if v.Passkeys {
					<button type="button" class="pc-btn hidden" data-passkey-signin data-failed={ i18n.T(ctx, "auth.passkey.failed") } data-closed={ i18n.T(ctx, "auth.passkey.closed") } disabled?={ v.Error == "locked" }>{ i18n.T(ctx, "auth.passkey.sign_in") }</button>
				}
				<p class="help">{ i18n.T(ctx, "auth.forgot") } <code>proxier manage reset-password &lt;username&gt;</code></p>
			</form>
		</main>
		if v.Passkeys {
			<script src={ Asset("js/passkey.js") } defer></script>
		}
	}
}

// SignInCode is the second step of a password sign-in with the
// authenticator app on.
templ SignInCode(v SignInView) {
	@page(i18n.T(ctx, "auth.sign_in"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			<form method="post" action="/login/code" aria-labelledby="si-h">
				<h1 id="si-h">{ i18n.T(ctx, "auth.sign_in") }</h1>
				if v.Error == "code" {
					<div role="alert" class="alert love"><span class="st st-broken" aria-hidden="true"></span>{ i18n.T(ctx, "auth.code.wrong") }</div>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				<input type="hidden" name="pending" value={ v.Pending }/>
				<div>
					<label for="c" class="lbl">{ i18n.T(ctx, "auth.code") }</label>
					<input id="c" name="code" class="pc-inp code-inp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" required autofocus/>
				</div>
				<button type="submit" class="pc-btn pc-pri">{ i18n.T(ctx, "auth.code.verify") }</button>
				<p class="help">
					{ i18n.T(ctx, "auth.code.help") }
					<a href={ templ.SafeURL("/login?next=" + url.QueryEscape(v.Next)) }>{ i18n.T(ctx, "auth.code.start_over") }</a>
				</p>
				<p class="help">{ i18n.T(ctx, "auth.code.lost") } <code>proxier manage reset-2fa &lt;username&gt;</code></p>
			</form>
		</main>
	}
}

templ signInBar() {
	<div class="signin-bar">
		<span class="hdr-logo"><span class="logo-mark" aria-hidden="true"></span>proxier</span>
	</div>
}

// Setup is a new member's setup link: they choose their password and are
// signed in. A browser signed in as someone else is told to sign out first.
templ Setup(v SetupView) {
	@page(i18n.T(ctx, "setup.title"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			if v.SignedIn != "" {
				<form method="post" action="/logout" aria-labelledby="su-h">
					<input type="hidden" name="_csrf" value={ CSRF(ctx) }/>
					<h1 id="su-h">{ i18n.T(ctx, "setup.title") }</h1>
					<div role="alert" class="alert gold"><span class="st st-look" aria-hidden="true"></span>{ i18n.T(ctx, "setup.signed_in", i18n.Args{"me": v.SignedIn, "name": v.Username}) }</div>
					<button type="submit" class="pc-btn pc-pri">{ i18n.T(ctx, "auth.sign_out") }</button>
				</form>
			} else {
				<form method="post" action={ templ.SafeURL("/setup/" + v.Token) } aria-labelledby="su-h">
					<h1 id="su-h">{ i18n.T(ctx, "setup.title") }</h1>
					<p class="help">{ i18n.T(ctx, "setup.note") }</p>
					if v.Err != "" {
						<div role="alert" class="alert love"><span class="st st-broken" aria-hidden="true"></span>{ i18n.T(ctx, v.Err) }</div>
					}
					<div>
						<label for="u" class="lbl">{ i18n.T(ctx, "auth.username") }</label>
						<input id="u" name="username" class="pc-inp" value={ v.Username } autocomplete="username" readonly/>
					</div>
					<div>
						<label for="p" class="lbl">{ i18n.T(ctx, "settings.password.new") }</label>
						<input id="p" name="password" class="pc-inp" type="password" autocomplete="new-password" minlength="12" required autofocus/>
						<p class="help">{ i18n.T(ctx, "settings.password.help") }</p>
					</div>
					<div>
						<label for="a" class="lbl">{ i18n.T(ctx, "settings.password.again") }</label>
						<input id="a" name="again" class="pc-inp" type="password" autocomplete="new-password" required/>
					</div>
					<button type="submit" class="pc-btn pc-pri">{ i18n.T(ctx, "setup.submit") }</button>
				</form>
			}
		</main>
	}
}

// SetupGone is a setup link that doesn't work: unknown, used, replaced,
// expired, or of a removed member. One page for all, so a link tells
// nothing about the others.
templ SetupGone() {
	@page(i18n.T(ctx, "setup.title"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			<div class="errpage">
				<h1>{ i18n.T(ctx, "setup.gone") }</h1>
				<p class="subtle">{ i18n.T(ctx, "setup.gone.text") }</p>
				<p><a href="/login">{ i18n.T(ctx, "auth.sign_in") }</a></p>
			</div>
		</main>
	}
}
