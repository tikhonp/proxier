package ui

import (
	"net/url"

	"github.com/tikhonp/proxier/internal/platform/i18n"
)

// SignIn is the standalone sign-in page: no shell, nothing but the form.
templ SignIn(v SignInView) {
	@page(i18n.T(ctx, "auth.sign_in"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			<form method="post" action="/login" aria-labelledby="si-h">
				<h1 id="si-h">{ i18n.T(ctx, "auth.sign_in") }</h1>
				switch v.Error {
					case "wrong":
						<div role="alert" class="alert love"><span class="st st-broken" aria-hidden="true"></span>{ i18n.T(ctx, "auth.wrong") }</div>
					case "code_expired":
						<div role="alert" class="alert gold"><span class="st st-look" aria-hidden="true"></span>{ i18n.T(ctx, "auth.code.expired") }</div>
					case "locked":
						<div role="status" class="alert gold"><span class="st st-look" aria-hidden="true"></span>{ i18n.N(ctx, "auth.locked", int64(v.LockedMin)) }</div>
				}
				if v.Ended != "" {
					<div role="status" class="alert">
						<span class="st st-unknown" aria-hidden="true"></span>
						if v.Next != "" && v.Next != "/" {
							{ i18n.T(ctx, "auth.ended."+v.Ended+".back", i18n.Args{"page": v.Next}) }
						} else {
							{ i18n.T(ctx, "auth.ended."+v.Ended) }
						}
					</div>
				}
				if v.Passkeys {
					<div role="alert" class="alert love hidden" id="pk-msg"><span class="st st-broken" aria-hidden="true"></span><span></span></div>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				<div>
					<label for="u" class="lbl">{ i18n.T(ctx, "auth.username") }</label>
					<input
						id="u"
						name="username"
						class="pc-inp"
						value={ v.Username }
						if v.Passkeys {
							autocomplete="username webauthn"
						} else {
							autocomplete="username"
						}
						autocapitalize="none"
						spellcheck="false"
						required
						autofocus?={ v.Username == "" }
					/>
				</div>
				<div>
					<label for="p" class="lbl">{ i18n.T(ctx, "auth.password") }</label>
					<input id="p" name="password" class="pc-inp" type="password" autocomplete="current-password" required autofocus?={ v.Username != "" }/>
				</div>
				<button type="submit" class="pc-btn pc-pri" disabled?={ v.Error == "locked" }>{ i18n.T(ctx, "auth.sign_in") }</button>
				if v.Passkeys {
					<button type="button" class="pc-btn hidden" data-passkey-signin data-failed={ i18n.T(ctx, "auth.passkey.failed") } disabled?={ v.Error == "locked" }>{ i18n.T(ctx, "auth.passkey.sign_in") }</button>
				}
				<p class="help">{ i18n.T(ctx, "auth.forgot") } <code>proxier manage reset-password</code></p>
			</form>
		</main>
		if v.Passkeys {
			<script src={ Asset("js/passkey.js") } defer></script>
		}
	}
}

// SignInCode is the second step of a password sign-in with the
// authenticator app on.
templ SignInCode(v SignInView) {
	@page(i18n.T(ctx, "auth.sign_in"), i18n.From(ctx).Lang) {
		@signInBar()
		<main class="signin">
			<form method="post" action="/login/code" aria-labelledby="si-h">
				<h1 id="si-h">{ i18n.T(ctx, "auth.sign_in") }</h1>
				if v.Error == "code" {
					<div role="alert" class="alert love"><span class="st st-broken" aria-hidden="true"></span>{ i18n.T(ctx, "auth.code.wrong") }</div>
				}
				<input type="hidden" name="next" value={ v.Next }/>
				<input type="hidden" name="pending" value={ v.Pending }/>
				<div>
					<label for="c" class="lbl">{ i18n.T(ctx, "auth.code") }</label>
					<input id="c" name="code" class="pc-inp code-inp" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]*" maxlength="7" required autofocus/>
				</div>
				<button type="submit" class="pc-btn pc-pri">{ i18n.T(ctx, "auth.code.verify") }</button>
				<p class="help">
					{ i18n.T(ctx, "auth.code.help") }
					<a href={ templ.SafeURL("/login?next=" + url.QueryEscape(v.Next)) }>{ i18n.T(ctx, "auth.code.start_over") }</a>
				</p>
				<p class="help">{ i18n.T(ctx, "auth.code.lost") } <code>proxier manage reset-2fa</code></p>
			</form>
		</main>
	}
}

templ signInBar() {
	<div class="signin-bar">
		<span class="hdr-logo"><span class="logo-mark" aria-hidden="true"></span>proxier</span>
	</div>
}
