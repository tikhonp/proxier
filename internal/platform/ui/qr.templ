package ui

import (
	"fmt"
	"strings"

	"rsc.io/qr"
)

// qrPath draws the dark modules of text as one SVG path, with a quiet zone of
// 4 modules, and returns the path and the side in modules. Pure Go, no PNG.
func qrPath(text string) (path string, side int, err error) {
	code, err := qr.Encode(text, qr.M)
	if err != nil {
		return "", 0, err
	}
	const quiet = 4
	var b strings.Builder
	for y := 0; y < code.Size; y++ {
		x := 0
		for x < code.Size {
			if !code.Black(x, y) {
				x++
				continue
			}
			start := x
			for x < code.Size && code.Black(x, y) {
				x++
			}
			fmt.Fprintf(&b, "M%d %dh%dv1h-%dz", start+quiet, y+quiet, x-start, x-start)
		}
	}
	return b.String(), code.Size + 2*quiet, nil
}

// QR renders text as a QR code: dark modules on a light tile, because phone
// scanners expect that even on a dark page. The colours come from classes
// (the CSP allows no inline style); label is the alt text.
templ QR(text, label string) {
	{{ path, side, err := qrPath(text) }}
	if err != nil {
		<span class="qr-err">{ err.Error() }</span>
	} else {
		<svg class="qr" role="img" aria-label={ label } viewBox={ fmt.Sprintf("0 0 %d %d", side, side) } shape-rendering="crispEdges" xmlns="http://www.w3.org/2000/svg">
			<rect class="qr-bg" width={ fmt.Sprint(side) } height={ fmt.Sprint(side) }></rect>
			<path class="qr-fg" d={ path }></path>
		</svg>
	}
}
