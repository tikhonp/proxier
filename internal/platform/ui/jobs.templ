package ui

import (
	"strconv"

	"github.com/tikhonp/proxier/internal/platform/i18n"
)

// JobStep is one line of a job's step list.
type JobStep struct {
	Name  string // already translated
	Kind  string // status marker kind
	State string
	Time  string
	Error string
}

// LogLine is one line of a job's log.
type LogLine struct {
	ID    int64
	Time  string
	Level string
	Text  string
}

// JobSteps is the step list of a job. The job page and the pages that embed a
// job (a server being provisioned) share it: the live stream replaces the
// element with this id.
templ JobSteps(steps []JobStep) {
	<ol id="job-steps" class="steps">
		for _, s := range steps {
			<li class="step" data-state={ s.State }>
				<span class="mk"><span class={ "st", "st-" + s.Kind } aria-hidden="true"></span></span>
				<span class="nm">{ s.Name }</span>
				<span class="sm subtle">{ s.Time }</span>
			</li>
		}
	</ol>
}

// JobLogLine is one line of the log, also what the live stream sends.
templ JobLogLine(l LogLine) {
	<div class={ "ll", "ll-" + l.Level } data-id={ strconv.FormatInt(l.ID, 10) }><span class="subtle">{ l.Time }</span><span class="tx">{ l.Text }</span></div>
}

// JobLog is the log box. It scrolls on its own (app.css), starts at its end
// and follows new lines while the reader is there (proxier.js). With a stream
// address the script follows it live (the page script finds
// #log[data-stream]); reload makes the page reload when the job ends, for
// pages whose other parts depend on its outcome. tabindex lets the keyboard
// scroll it.
templ JobLog(stream string, reload bool, lines []LogLine) {
	<div
		id="log"
		class="log"
		tabindex="0"
		data-t-follow-on={ i18n.T(ctx, "job.following") }
		data-t-follow-off={ i18n.T(ctx, "job.not_following") }
		if stream != "" {
			data-stream={ stream }
		}
		if reload {
			data-reload-on-done="true"
		}
	>
		for _, l := range lines {
			@JobLogLine(l)
		}
	</div>
}

// LogTools are the log box's controls for its head: Follow while the log is
// live and Expand (the box as tall as the window). Both need the script, so
// they start hidden and proxier.js shows them: Follow once the stream is
// open, Expand when the box has more than it shows.
templ LogTools(live bool) {
	if live {
		<label class="log-follow hidden"><input type="checkbox" data-log-follow checked/>{ i18n.T(ctx, "job.follow") }</label>
	}
	<button
		type="button"
		class="pc-btn pc-sm hidden"
		data-log-expand
		aria-controls="log"
		aria-pressed="false"
		data-t-more={ i18n.T(ctx, "job.expand") }
		data-t-less={ i18n.T(ctx, "job.collapse") }
	>{ i18n.T(ctx, "job.expand") }</button>
}
