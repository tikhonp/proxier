package ui

import (
	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/obs"
)

// page is the document skeleton shared by every page.
templ page(title string, lang i18n.Lang) {
	<!DOCTYPE html>
	<html lang={ string(lang) }>
		<head>
			@head(title, true)
		</head>
		<body>
			<div class="app">
				{ children... }
			</div>
		</body>
	</html>
}

// Standalone is a public page of a module, for people who never sign in:
// the logo bar and the page, without htmx and proxier.js; scripts are its
// own, by static path.
templ Standalone(title string, lang i18n.Lang, scripts []string) {
	<!DOCTYPE html>
	<html lang={ string(lang) }>
		<head>
			@head(title, false)
			for _, sc := range scripts {
				<script src={ Asset(sc) } defer></script>
			}
		</head>
		<body>
			<div class="app">
				@signInBar()
				{ children... }
			</div>
		</body>
	</html>
}

// head is what every page's head holds; htmx adds htmx and proxier.js.
templ head(title string, htmx bool) {
	<meta charset="utf-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
	<meta name="robots" content="noindex, nofollow"/>
	if htmx {
		<meta name="htmx-config" content={ htmxConfig }/>
	}
	<title>{ title } · Proxier</title>
	<meta name="apple-mobile-web-app-title" content="Proxier"/>
	<link rel="icon" href={ Asset("icons/favicon.ico") } sizes="48x48"/>
	<link rel="icon" href={ Asset("icons/icon.svg") } type="image/svg+xml"/>
	<link rel="apple-touch-icon" href={ Asset("icons/apple-touch-icon.png") }/>
	<link rel="stylesheet" href={ Asset("css/tokens.css") }/>
	<link rel="stylesheet" href={ Asset("css/fonts.css") }/>
	<link rel="stylesheet" href={ Asset("css/app.css") }/>
	if htmx {
		<script src={ Asset("js/htmx.min.js") } defer></script>
		<script src={ Asset("js/proxier.js") } defer></script>
	}
}

// Layout is the signed-in shell: header, sidebar, main, key line and the
// pop-ups. Its children are the page.
templ Layout(s Shell) {
	<!DOCTYPE html>
	<html lang={ string(s.Lang) }>
		<head>
			@head(s.Title, true)
			for _, m := range s.Scripts {
				<script type="module" src={ Asset(m) }></script>
			}
		</head>
		<body hx-headers={ csrfHeaders(s.CSRF) }>
			<div class="app" id="app">
				@header(s)
				<div class="body">
					<nav class="side pc-side" aria-label={ i18n.T(ctx, "ui.main_nav") }>
						for _, g := range s.Nav {
							<div class="side-group">{ i18n.T(ctx, g.Label) }</div>
							for _, it := range g.Items {
								<a
									href={ templ.SafeURL(it.Href) }
									data-goto={ it.GoKey }
									if isCurrent(s.Path, it.Href) {
										aria-current="page"
									}
								>
									<span class="mark" aria-hidden="true">
										if isCurrent(s.Path, it.Href) {
											›
										}
									</span>
									<span class="flex1">{ i18n.T(ctx, it.Label) }</span>
								</a>
							}
						}
						<div class="side-ver" title={ i18n.T(ctx, "ui.version") + " " + obs.AppVersion }>{ obs.AppVersion }</div>
					</nav>
					<main class="main" id="main">
						{ children... }
					</main>
				</div>
				@keyLine(s)
				@popups(s)
			</div>
		</body>
	</html>
}

func isCurrent(path, href string) bool {
	if href == "/" {
		return path == "/"
	}
	return path == href || (len(path) > len(href) && path[:len(href)] == href && path[len(href)] == '/')
}

// header ends with the admin's name and Sign out, a square icon cell of its
// own so a long name gives way and never pushes it off the screen; its label
// is screen-reader text, which the : pop-up reads too. Settings has no cell: it
// is in the sidebar, and its hidden action keeps it in the : pop-up.
templ header(s Shell) {
	<header class="hdr">
		<button class="hdr-menu pc-menu pc-seg" type="button" data-drawer-toggle aria-label={ i18n.T(ctx, "ui.menu") }>
			<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M2 4h12M2 8h12M2 12h12"></path></svg>
		</button>
		<a href="/" class="hdr-logo pc-seg"><span class="logo-mark" aria-hidden="true"></span>proxier</a>
		<button type="button" class="hdr-search pc-field" data-open-palette="all" aria-label={ i18n.T(ctx, "ui.search_label") }>
			<span class="slash" aria-hidden="true">/</span><span class="hdr-ph">{ i18n.T(ctx, "ui.search_placeholder") }</span>
			<svg class="hdr-glass" width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="7" cy="7" r="4.5"></circle><path d="M10.5 10.5L14 14"></path></svg>
		</button>
		if s.JobsCell != nil {
			@s.JobsCell
		}
		if s.Warning != nil {
			<a href={ templ.SafeURL(s.Warning.Href) } class="hdr-cell hdr-warn pc-seg pc-hide-s"><span class="st st-look" aria-hidden="true"></span>{ s.Warning.Text }</a>
		}
		<div class="hdr-cell hdr-admin"><span class="admin-name" title={ s.Member }>{ s.Member }</span></div>
		<form method="post" action="/logout" class="hdr-out">
			<input type="hidden" name="_csrf" value={ CSRF(ctx) }/>
			<button type="submit" class="hdr-out-btn pc-seg" data-action="auth.sign_out" data-key="" title={ i18n.T(ctx, "auth.sign_out") }>
				<svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M6.5 2.5h-3v11h3M10 5l3 3-3 3M13 8H6.5"></path></svg><span class="sr">{ i18n.T(ctx, "auth.sign_out") }</span>
			</button>
		</form>
		@ActionButton(Action{ID: "nav.settings", Label: "nav.settings", Method: "GET", Href: "/settings", Hidden: true})
	</header>
}

// keyLine holds the which-key strip that g opens: placed over the page right
// above the line, so showing it neither lengthens the page nor covers the line.
templ keyLine(s Shell) {
	<footer class="pc-keys" id="keyline">
		<div class="whichkey hidden" id="whichkey" role="navigation" aria-label={ i18n.T(ctx, "ui.key.goto") } data-pending-hint={ i18n.T(ctx, "ui.key.go_pending") }>
			for _, g := range s.Nav {
				for _, it := range g.Items {
					if it.GoKey != "" {
						<a href={ templ.SafeURL(it.Href) } data-go-key={ it.GoKey } class="pc-seg"><span class="k">{ it.GoKey }</span>{ i18n.T(ctx, it.Label) }</a>
					}
				}
			}
			<span class="wk-top" id="wk-top"><span class="k">g</span>{ i18n.T(ctx, "ui.key.top") }</span>
		</div>
		<div class="keyline-in">
			<span class="msg hidden" id="keymsg" role="status"></span>
			<span id="keyhints" class="pc-keys-only" data-default={ i18n.T(ctx, s.PageKeys) }>{ i18n.T(ctx, s.PageKeys) }</span>
		</div>
		<div class="keyline-global pc-keys-only">
			<span><span class="k">/</span> { i18n.T(ctx, "ui.key.search") }</span>
			<span><span class="k">:</span> { i18n.T(ctx, "ui.key.actions") }</span>
			<span><span class="k">g</span> { i18n.T(ctx, "ui.key.goto") }</span>
			<span><span class="k">?</span> { i18n.T(ctx, "ui.key.keys") }</span>
		</div>
	</footer>
}

templ popups(s Shell) {
	<div
		class="pal hidden"
		id="palette"
		data-t-goto={ i18n.T(ctx, "ui.go_to") }
		data-t-actions={ i18n.T(ctx, "ui.actions") }
		data-t-none={ i18n.T(ctx, "ui.nothing") }
		data-t-copied={ i18n.T(ctx, "ui.copied") }
	>
		<div class="pal-box" role="dialog" aria-modal="true" aria-label={ i18n.T(ctx, "ui.search_label") }>
			<label class="pal-in">
				<span class="prompt" id="pal-prompt" aria-hidden="true">/</span>
				<input type="search" id="pal-input" autocomplete="off" aria-label={ i18n.T(ctx, "ui.search_label") } placeholder={ i18n.T(ctx, "ui.search_placeholder") }/>
			</label>
			<div class="pal-list" id="pal-list"></div>
			<div class="pal-foot pc-keys-only">
				<span><span class="k">↑ ↓ ⌃N ⌃P</span> { i18n.T(ctx, "ui.key.move") }</span>
				<span><span class="k">↵</span> { i18n.T(ctx, "ui.key.run") }</span>
				<span><span class="k">:</span> { i18n.T(ctx, "ui.key.actions_only") }</span>
				<span><span class="k">esc</span> { i18n.T(ctx, "ui.closes") }</span>
			</div>
		</div>
	</div>
	<template id="keys-template">
		<div class="pal" id="keys-sheet">
			<section class="keys-sheet" role="dialog" aria-modal="true" aria-labelledby="keys-h">
				<div class="dlg-title">
					<h2 id="keys-h">{ i18n.T(ctx, "ui.keys") } <span class="sm subtle">{ i18n.T(ctx, "ui.esc_closes") }</span></h2>
					<button type="button" class="pc-seg pc-close" data-keys-close aria-label={ i18n.T(ctx, "ui.close") }>×</button>
				</div>
				<div class="keys-grid">
					for _, g := range s.Keys {
						<div>
							<h3>{ i18n.T(ctx, g.Where) }</h3>
							for _, k := range g.Keys {
								<div class="kk"><span class="bold nowrap">{ k.Keys }</span><span class="subtle">{ i18n.T(ctx, k.What) }</span></div>
							}
						</div>
					}
				</div>
				<p class="keys-note">{ i18n.T(ctx, "ui.keys_note") }</p>
			</section>
		</div>
	</template>
}
