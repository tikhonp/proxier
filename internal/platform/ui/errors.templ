package ui

import (
	"fmt"

	"github.com/tikhonp/proxier/internal/platform/access"
	"github.com/tikhonp/proxier/internal/platform/i18n"
)

// ErrorPage is the page for 403, 404 and 500; no shell, so it works for
// a signed-out visitor too.
templ ErrorPage(code int) {
	@page(i18n.T(ctx, errKey(code)), i18n.From(ctx).Lang) {
		<div class="signin-bar">
			<a href="/" class="hdr-logo pc-seg"><span class="logo-mark" aria-hidden="true"></span>proxier</a>
		</div>
		<main class="errpage">
			<h1>{ i18n.T(ctx, errKey(code)) }</h1>
			<p class="subtle">{ i18n.T(ctx, errKey(code) + ".text") }</p>
			<p><a href="/">{ i18n.T(ctx, "err.back") }</a></p>
		</main>
	}
}

func errKey(code int) string {
	switch code {
	case 403, 404:
		return fmt.Sprintf("err.%d", code)
	}
	return "err.500"
}

// ForbiddenPage is the 403 of a member whose access doesn't reach a page:
// it names the area, so they know whom to ask and what for.
templ ForbiddenPage(area access.Area) {
	@page(i18n.T(ctx, "err.403"), i18n.From(ctx).Lang) {
		<div class="signin-bar">
			<a href="/" class="hdr-logo pc-seg"><span class="logo-mark" aria-hidden="true"></span>proxier</a>
		</div>
		<main class="errpage" data-area={ string(area) }>
			<h1>{ i18n.T(ctx, "err.403") }</h1>
			<p class="subtle">{ i18n.T(ctx, "err.403.area", i18n.Args{"area": i18n.T(ctx, "access.area."+string(area))}) }</p>
			<p><a href="/">{ i18n.T(ctx, "err.back") }</a></p>
		</main>
	}
}

// ForbiddenNotice is the same refusal for htmx, which swaps no 4xx: the key
// line shows its text.
templ ForbiddenNotice(area access.Area) {
	<p class="forbidden" role="alert" data-area={ string(area) }>{ i18n.T(ctx, "err.403.area_short", i18n.Args{"area": i18n.T(ctx, "access.area."+string(area))}) }</p>
}
