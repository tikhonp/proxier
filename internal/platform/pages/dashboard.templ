package pages

import (
	"github.com/tikhonp/proxier/internal/platform/i18n"
	"github.com/tikhonp/proxier/internal/platform/ui"
)

templ dashboardPage(s ui.Shell, v dashboardView) {
	@ui.Layout(s) {
		@ui.TitleBlock(i18n.T(ctx, "nav.dashboard")) {
			<div class="status">
				if !v.NotConfigured && len(v.Failed) == 0 {
					<span>{ i18n.T(ctx, "dash.quiet") }</span>
				}
			</div>
		}
		if v.NotConfigured {
			@ui.Band("gold") {
				<span class="bold">{ i18n.T(ctx, "dash.notifications_not_configured") }</span>
				<span>{ i18n.T(ctx, "dash.notifications_not_configured.text") }</span>
				<span class="flex1"></span>
				@ui.ActionButton(ui.Action{ID: "telegram.configure", Label: "dash.configure_telegram", Method: "GET", Href: "/settings/integrations/telegram", Small: true})
			}
		}
		if len(v.Failed) > 0 {
			<div id="failed-notifications">
				@ui.Area(i18n.T(ctx, "dash.failed_notifications"), i18n.T(ctx, "dash.failed_notifications.note")) {
					for _, n := range v.Failed {
						<div class="row failed-note">
							<span>
								@ui.Status("broken", i18n.T(ctx, "dash.failed"))
							</span>
							<span>
								<span class="bold">{ n.Message.Emoji } { n.Message.Title }</span>
								<span class="subtle"> · { n.LastError }</span>
							</span>
							<span class="subtle">
								@ui.Time(n.CreatedAt.Time)
							</span>
							@ui.ActionButton(ui.Action{
								ID: "notification.retry", Label: "job.retry", Method: "POST",
								Href: "/notifications/" + chatIDString(n.ID) + "/retry", Small: true,
							})
						</div>
					}
				}
			</div>
		}
		if !v.NotConfigured && len(v.Failed) == 0 {
			@ui.EmptyState(i18n.T(ctx, "dash.empty"), i18n.T(ctx, "dash.empty_next"))
		}
	}
}

// searchHits is the "Go to" fragment of the search pop-up: one link per hit.
templ searchHits(hits []ui.SearchHit) {
	<ul>
		for _, h := range hits {
			<li><a href={ templ.SafeURL(h.Href) } data-meta={ h.Meta }>{ h.Label }</a></li>
		}
	</ul>
}
